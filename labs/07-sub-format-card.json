{
  "name": "HERMES-LAB - 07 Sub Format Card",
  "description": "Ladder step 3 (DRY): shared callable sub-workflow. Execute Workflow Trigger with typed inputs (fullName, company, score) -> formats a lead card string + HOT/WARM tier -> return-shaper whitelists the contract. Called by 07A (mode each) and 07B (mode once).",
  "nodes": [
    {
      "id": "6430ceee-c6cc-4f67-b808-c2d00734809c",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "fullName",
              "type": "string"
            },
            {
              "name": "company",
              "type": "string"
            },
            {
              "name": "score",
              "type": "number"
            }
          ]
        }
      }
    },
    {
      "id": "d84816d2-22b5-4891-9f70-163f205e1a3e",
      "name": "Score Card",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "card",
              "name": "card",
              "value": "=LEAD {{ $json.fullName }} @ {{ $json.company }} | score {{ $json.score }}",
              "type": "string"
            },
            {
              "id": "tier",
              "name": "tier",
              "value": "={{ $json.score >= 70 ? 'HOT' : 'WARM' }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "d71b4a84-9758-4ed8-a0fa-d8f881e90206",
      "name": "Return Card",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "c",
              "name": "card",
              "value": "={{ $(\"Score Card\").item.json.card }}",
              "type": "string"
            },
            {
              "id": "t",
              "name": "tier",
              "value": "={{ $(\"Score Card\").item.json.tier }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Score Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score Card": {
      "main": [
        [
          {
            "node": "Return Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "staticData": null,
  "nodeGroups": [],
  "pinData": null,
  "tags": [
    {
      "name": "hermes-lab"
    },
    {
      "name": "subworkflow"
    }
  ],
  "versionMetadata": {
    "name": "Initial shared format-card sub",
    "description": "Shared 'format card' function used by two parents; demonstrates sub-workflow reuse (DRY)."
  },
  "active": false
}
